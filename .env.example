# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Portal reads these directly from the process environment; it does not load
# `.env` itself. Export them, or source the file, before running the CLI or the
# MCP server.

# A long-lived TinyHumans API key, sent as `x-api-key`. Either this or
# TINYHUMANS_TOKEN is required for every capability except the public health
# check.
TINYHUMANS_API_KEY=replace-me

# A user bearer token, sent as `Authorization: Bearer <token>`. Use this instead
# of the API key when acting on behalf of a signed-in user.
# TINYHUMANS_TOKEN=replace-me

# The backend origin. Defaults to https://api.tinyhumans.ai. Point it at
# https://staging-api.tinyhumans.ai or http://localhost:5005 to work against
# another deployment.
# TINYHUMANS_BASE_URL=https://api.tinyhumans.ai

# Backtraces for local debugging: 1 for a short backtrace, "full" for all frames.
# RUST_BACKTRACE=1
